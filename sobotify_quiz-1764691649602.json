      "targets": [
        {
          "dataset": "sobotify_data",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH runs AS (\r\n    SELECT\r\n        qi.question_time,\r\n        qi.answer_time,\r\n        qi.latency_ms / 1000.0 AS latency_s,\r\n\r\n        CASE\r\n            WHEN EXISTS (\r\n                SELECT 1\r\n                FROM human_speak hs\r\n                WHERE hs.topic IN ('log/quiz/answer/correct','quiz/answer/correct')\r\n                  AND hs.ts BETWEEN qi.question_time\r\n                               AND qi.answer_time + INTERVAL 25 SECOND\r\n            ) THEN 1\r\n            WHEN EXISTS (\r\n                SELECT 1\r\n                FROM human_speak hs\r\n                WHERE hs.topic IN ('log/quiz/answer/wrong','quiz/answer/wrong')\r\n                  AND hs.ts BETWEEN qi.question_time\r\n                               AND qi.answer_time + INTERVAL 25 SECOND\r\n            ) THEN 0\r\n            ELSE NULL\r\n        END AS is_correct\r\n    FROM quiz_interactions qi\r\n    WHERE $__timeFilter(qi.answer_time)\r\n),\r\n\r\ncleaned AS (\r\n    SELECT\r\n        question_time,\r\n        latency_s,\r\n        is_correct\r\n    FROM runs\r\n    WHERE is_correct IS NOT NULL\r\n),\r\n\r\ncum AS (\r\n    SELECT\r\n        question_time,\r\n        latency_s,\r\n        is_correct,\r\n\r\n        ROW_NUMBER() OVER (ORDER BY question_time) AS n,\r\n        SUM(is_correct) OVER (ORDER BY question_time) AS n_correct\r\n    FROM cleaned\r\n)\r\n\r\nSELECT\r\n    question_time AS time,\r\n    latency_s,\r\n\r\n    (n_correct * 100.0 / n) AS percent_correct\r\nFROM cum\r\nORDER BY time;\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Learning Performance Over Time",
      "type": "timeseries"
