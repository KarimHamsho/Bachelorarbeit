        {
          "dataset": "sobotify_data",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- =============================\r\n-- 1) QUESTION EVENTS (blau)\r\n-- =============================\r\n(\r\n  SELECT\r\n    q.ts AS time,\r\n    1 AS value,\r\n    'Question' AS event_label\r\n  FROM robot_speak q\r\n  WHERE q.topic = 'log/quiz/question'\r\n    AND $__timeFilter(q.ts)\r\n)\r\n\r\nUNION ALL\r\n\r\n-- =============================\r\n-- 2) CORRECT ANSWERS (grün)\r\n-- Zeit = speech-recognition/statement\r\n-- correctness = erstes Bewertungs-Event danach\r\n-- =============================\r\n(\r\n  SELECT\r\n    hs.ts AS time,\r\n    2 AS value,\r\n    'Correct' AS event_label\r\n  FROM human_speak hs\r\n  WHERE hs.topic = 'speech-recognition/statement'\r\n    AND $__timeFilter(hs.ts)\r\n    AND EXISTS (\r\n      SELECT 1\r\n      FROM human_speak ok\r\n      WHERE ok.topic IN ('log/quiz/answer/correct','quiz/answer/correct')\r\n        AND ok.ts = (\r\n          -- ERSTES Bewertungs-Event nach der Antwort\r\n          SELECT MIN(ev.ts)\r\n          FROM human_speak ev\r\n          WHERE ev.ts > hs.ts\r\n            AND ev.topic IN (\r\n              'log/quiz/answer/correct','quiz/answer/correct',\r\n              'log/quiz/answer/wrong','quiz/answer/wrong'\r\n            )\r\n        )\r\n    )\r\n)\r\n\r\nUNION ALL\r\n\r\n-- =============================\r\n-- 3) WRONG ANSWERS (rot)\r\n-- Zeit = speech-recognition/statement\r\n-- correctness = erstes Bewertungs-Event danach\r\n-- =============================\r\n(\r\n  SELECT\r\n    hs.ts AS time,\r\n    3 AS value,\r\n    'Wrong' AS event_label\r\n  FROM human_speak hs\r\n  WHERE hs.topic = 'speech-recognition/statement'\r\n    AND $__timeFilter(hs.ts)\r\n    AND EXISTS (\r\n      SELECT 1\r\n      FROM human_speak wr\r\n      WHERE wr.topic IN ('log/quiz/answer/wrong','quiz/answer/wrong')\r\n        AND wr.ts = (\r\n          -- ERSTES Bewertungs-Event nach der Antwort\r\n          SELECT MIN(ev.ts)\r\n          FROM human_speak ev\r\n          WHERE ev.ts > hs.ts\r\n            AND ev.topic IN (\r\n              'log/quiz/answer/correct','quiz/answer/correct',\r\n              'log/quiz/answer/wrong','quiz/answer/wrong'\r\n            )\r\n        )\r\n    )\r\n)\r\n\r\nORDER BY time;\r\n",
          "refId": "A",
          "sql": {
