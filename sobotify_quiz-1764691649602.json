      "targets": [
        {
          "dataset": "sobotify_data",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- Alle Quizfragen im ausgewählten Zeitraum\r\nWITH questions AS (\r\n    SELECT\r\n        ts,\r\n        message\r\n    FROM robot_speak\r\n    WHERE topic = 'log/quiz/question'\r\n),\r\n\r\n-- Alle erkannten Antworten (jede Antwort = ein Versuch)\r\nanswers_raw AS (\r\n    SELECT\r\n        hs.ts      AS answer_time,\r\n        hs.message AS answer_text\r\n    FROM human_speak hs\r\n    WHERE hs.topic = 'speech-recognition/statement'\r\n      AND $__timeFilter(hs.ts)\r\n),\r\n\r\n-- Jede Antwort bekommt die letzte Frage davor zugeordnet\r\nanswers_with_question AS (\r\n    SELECT\r\n        ar.answer_time,\r\n        ar.answer_text,\r\n\r\n        (\r\n            SELECT q.ts\r\n            FROM questions q\r\n            WHERE q.ts <= ar.answer_time\r\n            ORDER BY q.ts DESC\r\n            LIMIT 1\r\n        ) AS question_time,\r\n\r\n        (\r\n            SELECT q.message\r\n            FROM questions q\r\n            WHERE q.ts <= ar.answer_time\r\n            ORDER BY q.ts DESC\r\n            LIMIT 1\r\n        ) AS question_text\r\n    FROM answers_raw ar\r\n),\r\n\r\n-- Korrektheit pro Antwort bestimmen (erstes Bewertungs-Topic nach der Antwort)\r\nanswers_scored AS (\r\n    SELECT\r\n        awq.question_time,\r\n        awq.question_text,\r\n        awq.answer_time,\r\n        awq.answer_text,\r\n\r\n        CASE\r\n            WHEN EXISTS (\r\n                SELECT 1\r\n                FROM human_speak ev\r\n                WHERE ev.topic IN ('log/quiz/answer/correct','quiz/answer/correct')\r\n                  AND ev.ts = (\r\n                      SELECT MIN(e2.ts)\r\n                      FROM human_speak e2\r\n                      WHERE e2.ts > awq.answer_time\r\n                        AND e2.topic IN (\r\n                            'log/quiz/answer/correct','quiz/answer/correct',\r\n                            'log/quiz/answer/wrong','quiz/answer/wrong'\r\n                        )\r\n                  )\r\n            ) THEN 'Correct'\r\n\r\n            WHEN EXISTS (\r\n                SELECT 1\r\n                FROM human_speak ev\r\n                WHERE ev.topic IN ('log/quiz/answer/wrong','quiz/answer/wrong')\r\n                  AND ev.ts = (\r\n                      SELECT MIN(e2.ts)\r\n                      FROM human_speak e2\r\n                      WHERE e2.ts > awq.answer_time\r\n                        AND e2.topic IN (\r\n                            'log/quiz/answer/correct','quiz/answer/correct',\r\n                            'log/quiz/answer/wrong','quiz/answer/wrong'\r\n                        )\r\n                  )\r\n            ) THEN 'Wrong'\r\n\r\n            ELSE 'Unknown'\r\n        END AS correctness\r\n    FROM answers_with_question awq\r\n)\r\n\r\nSELECT\r\n    question_time AS time,   -- X-Achse in Grafana\r\n    question_text AS question,\r\n    answer_time,\r\n    answer_text,\r\n    ROUND(\r\n        TIMESTAMPDIFF(MICROSECOND, question_time, answer_time) / 1000000.0,\r\n        2\r\n    ) AS latency_s,\r\n    correctness\r\nFROM answers_scored\r\nWHERE question_time IS NOT NULL\r\nORDER BY question_time DESC, answer_time ASC\r\nLIMIT 500;\r\n",
          "refId": "A",
          "sql": {
            "columns": [
