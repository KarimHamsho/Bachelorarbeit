        {
          "dataset": "sobotify_data",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH attempts AS (\r\n    SELECT\r\n        qi.question_time,\r\n        qi.answer_time,\r\n        qi.latency_ms,\r\n        qi.answer_text,\r\n\r\n        (\r\n            SELECT ev.topic\r\n            FROM human_speak ev\r\n            WHERE ev.ts > qi.answer_time\r\n              AND ev.ts <= qi.answer_time + INTERVAL 20 SECOND\r\n              AND ev.topic IN (\r\n                'log/quiz/answer/correct','quiz/answer/correct',\r\n                'log/quiz/answer/wrong','quiz/answer/wrong'\r\n              )\r\n            ORDER BY ev.ts\r\n            LIMIT 1\r\n        ) AS eval_topic\r\n    FROM quiz_interactions qi\r\n    WHERE $__timeFilter(qi.answer_time)   -- <=== wichtig\r\n)\r\n\r\nSELECT\r\n    AVG(latency_ms) / 1000.0 AS avg_latency_s,\r\n\r\n    COUNT(*) AS total_interactions,\r\n\r\n    SUM(CASE WHEN eval_topic LIKE '%correct%' THEN 1 ELSE 0 END) AS total_correct,\r\n    SUM(CASE WHEN eval_topic LIKE '%wrong%'   THEN 1 ELSE 0 END) AS total_wrong,\r\n\r\n    100.0 * SUM(CASE WHEN eval_topic LIKE '%correct%' THEN 1 ELSE 0 END)\r\n           / NULLIF(COUNT(*), 0) AS correct_percent\r\nFROM attempts;\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "avg_latency",
      "type": "stat"
